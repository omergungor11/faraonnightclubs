FROM node:22-alpine

WORKDIR /app

# Enable corepack to use pnpm
RUN corepack enable pnpm

# Copy package.json and pnpm-lock.yaml first to cache the install step
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install

# We don't copy the rest of the files here because they will be mounted via docker-compose
# This keeps the image build fast and allows hot-reloading.

EXPOSE 3000

CMD ["pnpm", "dev"]
